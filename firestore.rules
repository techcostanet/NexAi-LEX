rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de acesso online para a arquitetura multi-tenant NexAi-LEX
    // Permite sincronização em tempo real das coleções:
    // notifications_inbox, deadlines, cases, tenants e users
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
